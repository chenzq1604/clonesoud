# 火山引擎方舟 API Key（文生图）
ARK_API_KEY=your_ark_api_key

# 本地代理（访问火山引擎节点）
HTTP_PROXY=http://127.0.0.1:7890

# 后端监听配置
APP_HOST=127.0.0.1
APP_PORT=8000

# 上传目录与数据库
UPLOAD_DIR=../uploads
DATABASE_URL=sqlite:///./projects.db

# 前端开发服务器地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CosyVoice3 本地推理服务（声音克隆与语音合成，一般无需修改）
# 长文本分段合成耗时约 0.45 秒/字，超时需留足余量
COSYVOICE_BASE_URL=http://127.0.0.1:9880
COSYVOICE_TIMEOUT=1800

# 本地 ComfyUI 服务（Wan 2.2 文生/图生视频，一般无需修改）
# 121 帧本地 GPU 推理约需数分钟，超时需留足余量
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=1800

# 火山引擎方舟模型配置（文生图，一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
IMAGE_MODEL=doubao-seedream-5.0-lite

# 演示模式：设置为 true 时文生图返回本地占位图，便于前端联调
# （语音已全部本地化，不受此开关影响）
DEMO_MODE=false
